# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub - it is already
# listed in .gitignore to help prevent that.

# Get this from your Brevo account: Settings > SMTP & API > API Keys
BREVO_API_KEY=your_brevo_api_key_here

# The email address that receives breach alerts. This should also
# be a VERIFIED sender in your Brevo account (usually the email
# you signed up with), since Brevo requires the "from" address to
# be verified before it will send.
ALERT_EMAIL=your_email@example.com

# Any random string - used to secure Flask's flash-message cookies
FLASK_SECRET_KEY=change-this-to-any-random-string

# Render sets this automatically - only needed for local testing
PORT=5000

# Optional PostgreSQL/Neon database connection.
# When present, the application uses PostgreSQL instead of the local SQLite fallback.
# Example: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# History retention (days)
# Low-value/info events are removed after this period.
RETENTION_INFO_DAYS=30
# Warning events are kept longer.
RETENTION_WARNING_DAYS=90
# Point-in-time state snapshots follow this retention.
RETENTION_STATE_DAYS=30
# How often the running engine performs retention maintenance.
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
